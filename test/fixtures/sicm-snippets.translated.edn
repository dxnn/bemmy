  {:chapter "4" :section "4.3.1" :page 308 :idx 148 :code "(define ((unstable-manifold T xe ye dx dy rho eps) param)\n  (let ((n (floor->exact (/ (log (/ param eps)) (log rho)))))\n    ((iterated-map T n)\n     (+ xe (* dx (/ param (expt rho n))))\n     (+ ye (* dy (/ param (expt rho n))))\n     make-point\n     (lambda () (error \"Failed\")))))" :translated "(defn unstable-manifold [T xe ye dx dy rho eps]\n  (fn [param]\n        (let [n (floor->exact (/ (log (/ param eps)) (log rho)))]\n            ((iterated-map T n)\n                 (+ xe (* dx (/ param (expt rho n))))\n                 (+ ye (* dy (/ param (expt rho n)))) make-point\n                 (fn [] (throw (ex-info \"Failed\" {})))))))"}
  {:chapter "4" :section "4.3.1" :page 308 :idx 149 :code "(define (plot-parametric-fill win f a b near?)\n  (let loop ((a a) (xa (f a)) (b b) (xb (f b)))\n    (if (not (close-enuf? a b (* 10 *machine-epsilon*)))\n      (let ((m (/ (+ a b) 2)))\n        (let ((xm (f m)))\n          (plot-point win (abscissa xm) (ordinate xm))\n          (if (not (near? xa xm))\n            (loop a xa m xm))\n          (if (not (near? xb xm))\n            (loop m xm b xb)))))))" :translated "(defn plot-parametric-fill [win f a b near?]\n  (loop [a a xa (f a) b b xb (f b)]\n        (when (not (close-enuf? a b (* 10 *machine-epsilon*)))\n              (let [m (/ (+ a b) 2)]\n                    (let [xm (f m)]\n                         (plot-point win (abscissa xm) (ordinate xm))\n                         (when (not (near? xa xm)) (loop a xa m xm))\n                         (when (not (near? xb xm)) (loop m xm b xb)))))))"}
  {:chapter "4" :section "4.3.1" :page 309 :idx 150 :code "(define (cylinder-near? eps)\n  (let ((eps2 (square eps)))\n    (lambda (point1 point2)\n      (< (+ (square ((principal-value pi)\n                     (- (abscissa point1) (abscissa point2))))\n            (square (- (ordinate point1) (ordinate point2))))\n         eps2))))" :translated "(defn cylinder-near? [eps]\n  (let [eps2 (square eps)]\n        (fn [point1 point2]\n             (<\n                 (+\n                    (square\n                       ((principal-value pi)\n                               (-\n                                                     (abscissa point1)\n                                                     (abscissa point2))))\n                    (square (- (ordinate point1) (ordinate point2))))\n                 eps2))))"}
  {:chapter "4" :section "4.5.1" :page 321 :idx 151 :code "(define (radially-mapping-points Tmap Jmin Jmax phi eps)\n  (bisect\n    (lambda (J)\n      ((principal-value pi)\n       (Tmap phi J\n             (lambda (phip Jp) (- phi phip))\n             (lambda () (error \"should not get here\")))))\n    Jmin Jmax eps))" :translated "(defn radially-mapping-points [Tmap Jmin Jmax phi eps]\n  (bisect\n        (fn [J]\n                ((principal-value pi)\n                    (Tmap\n                                          phi J\n                                          (fn [phip Jp]\n                                                (- phi phip))\n                                          (fn []\n                                                (throw\n                                                    (ex-info\n                                                           \"should not get here\"\n                                                           {}))))))\n        Jmin Jmax eps))"}
