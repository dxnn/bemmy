  {:chapter "2" :section "2.7" :page 139 :idx 89 :code "(define (Rz-matrix angle)\n  (matrix-by-rows\n    (list (cos angle) (- (sin angle)) 0)\n    (list (sin angle) (cos angle) 0)\n    (list 0 0 1)))\n\n(define (Rx-matrix angle)\n  (matrix-by-rows\n    (list 1 0 0)\n    (list 0 (cos angle) (- (sin angle)))\n    (list 0 (sin angle) (cos angle))))\n\n(define (Euler->M angles)\n  (let ((theta (ref angles 0))\n        (phi (ref angles 1))\n        (psi (ref angles 2)))\n\n    (* (Rz-matrix phi)\n       (Rx-matrix theta)\n       (Rz-matrix psi))))" :translated "(defn Rz-matrix [angle]\n  (matrix-by-rows\n        (list (cos angle) (- (sin angle)) 0)\n        (list (sin angle) (cos angle) 0) (list 0 0 1)))\n\n\n(defn Rx-matrix [angle]\n  (matrix-by-rows\n        (list 1 0 0) (list 0 (cos angle) (- (sin angle)))\n        (list 0 (sin angle) (cos angle))))\n\n\n(defn Euler->M [angles]\n  (let [theta (ref angles 0) phi (ref angles 1) psi (ref angles 2)]\n        (* (Rz-matrix phi) (Rx-matrix theta) (Rz-matrix psi))))"}
