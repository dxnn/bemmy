  {:chapter "3" :section "3.9" :page 278 :idx 146 :code "(define ((standard-map K) theta I return failure)\n  (let ((nI (+ I (* K (sin theta)))))\n    (return ((principal-value :2pi) (+ theta nI))\n            ((principal-value :2pi) nI))))" :translated "(defn standard-map [K]\n  (fn [theta I return failure]\n        (let [nI (+ I (* K (sin theta)))]\n            (return\n                 ((principal-value (* 2 Math/PI)) (+ theta nI))\n                 ((principal-value (* 2 Math/PI)) nI)))))"}
