  {:chapter "3" :section "3.4" :page 229 :idx 130 :code "(define ((L-axisymmetric-top A C gMR) local)\n  (let ((q (coordinate local))\n        (qdot (velocity local)))\n    (let ((theta (ref q 0))\n          (thetadot (ref qdot 0))\n          (phidot (ref qdot 1))\n          (psidot (ref qdot 2)))\n      (+ (* 1/2 A\n            (+ (square thetadot)\n               (square (* phidot (sin theta)))))\n         (* 1/2 C\n            (square (+ psidot (* phidot (cos theta)))))\n         (* -1 gMR (cos theta))))))" :translated "(defn L-axisymmetric-top [A C gMR]\n  (fn [local]\n        (let [q (coordinate local) qdot (velocity local)]\n            (let [theta (ref q 0)\n                     thetadot (ref qdot 0)\n                     phidot (ref qdot 1)\n                     psidot (ref qdot 2)]\n                 (+\n                      (*\n                         1/2 A\n                         (+\n                            (square thetadot)\n                            (square (* phidot (sin theta)))))\n                      (*\n                         1/2 C\n                         (square (+ psidot (* phidot (cos theta)))))\n                      (* -1 gMR (cos theta)))))))"}
  {:chapter "3" :section "3.4" :page 229 :idx 131 :code "(show-expression\n  ((Lagrangian->Hamiltonian (L-axisymmetric-top 'A 'C 'gMR))\n   (up 't\n       (up 'theta 'phi 'psi)\n       (down 'p_theta 'p_phi 'p_psi))))" :translated "(simplify\n  ((Lagrangian->Hamiltonian (L-axisymmetric-top 'A 'C 'gMR))\n            (up\n                                                                       't\n                                                                       (up\n                                                                           'theta\n                                                                           'phi\n                                                                           'psi)\n                                                                       (down\n                                                                           'p_theta\n                                                                           'p_phi\n                                                                           'p_psi))))"}
