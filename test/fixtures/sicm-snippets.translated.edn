  {:chapter "3" :section "3.4" :page 228 :idx 129 :code "(show-expression\n  (((Hamilton-equations\n      (Lagrangian->Hamiltonian\n        (L-central-polar 'm (literal-function 'V))))\n    (up (literal-function 'r)\n        (literal-function 'phi))\n    (down (literal-function 'p_r)\n          (literal-function 'p_phi)))\n   't))" :translated "(simplify\n  (((Hamilton-equations\n              (Lagrangian->Hamiltonian\n                                  (L-central-polar\n                                                           'm\n                                                           (literal-function\n                                                                            'V))))\n             (up\n                                                                                                                                                                                                                                                                                                                                                          (literal-function\n                                                                                                                                                                                                                                                                                                                                                              'r)\n                                                                                                                                                                                                                                                                                                                                                          (literal-function\n                                                                                                                                                                                                     