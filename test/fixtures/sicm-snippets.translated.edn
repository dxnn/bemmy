  {:chapter "1" :section "1.8.4" :page 87 :idx 68 :code "(define ((V a GM0 GM1 m) t xy)\n  (let ((Omega (sqrt (/ (+ GM0 GM1) (expt a 3))))\n        (a0 (* (/ GM1 (+ GM0 GM1)) a))\n        (a1 (* (/ GM0 (+ GM0 GM1)) a)))\n    (let ((x (ref xy 0)) (y (ref xy 1))\n                         (x0 (* -1 a0 (cos (* Omega t))))\n                         (y0 (* -1 a0 (sin (* Omega t))))\n                         (x1 (* +1 a1 (cos (* Omega t))))\n                         (y1 (* +1 a1 (sin (* Omega t)))))\n      (let ((r0\n              (sqrt (+ (square (- x x0)) (square (- y y0)))))\n            (r1\n              (sqrt (+ (square (- x x1)) (square (- y y1))))))\n        (- (+ (/ (* GM0 m) r0) (/ (* GM1 m) r1)))))))" :translated "(defn V [a GM0 GM1 m]\n  (fn [t xy]\n        (let [Omega (sqrt (/ (+ GM0 GM1) (expt a 3)))\n                a0 (* (/ GM1 (+ GM0 GM1)) a)\n                a1 (* (/ GM0 (+ GM0 GM1)) a)]\n            (let [x (ref xy 0)\n                     y (ref xy 1)\n                     x0 (* -1 a0 (cos (* Omega t)))\n                     y0 (* -1 a0 (sin (* Omega t)))\n                     x1 (* +1 a1 (cos (* Omega t)))\n                     y1 (* +1 a1 (sin (* Omega t)))]\n                 (let [r0 (sqrt\n                               (+\n                                     (square (- x x0)) (square (- y y0))))\n                          r1 (sqrt\n                               (+\n                                     (square (- x x1)) (square (- y y1))))]\n                      (- (+ (/ (* GM0 m) r0) (/ (* GM1 m) r1))))))))"}
  {:chapter "1" :section "1.8.4" :page 88 :idx 69 :code "(define ((LR3B m a GM0 GM1) local)\n  (let ((q (coordinates local))\n        (qdot (velocities local))\n        (Omega (sqrt (/ (+ GM0 GM1) (expt a 3))))\n        (a0 (* (/ GM1 (+ GM0 GM1)) a))\n        (a1 (* (/ GM0 (+ GM0 GM1)) a)))\n    (let ((x (ref q 0))     (y (ref q 1))\n                            (xdot (ref qdot 0)) (ydot (ref qdot 1)))\n      (let ((r0 (sqrt (+ (square (+ x a0)) (square y))))\n            (r1 (sqrt (+ (square (- x a1)) (square y)))))\n        (+ (* 1/2 m (square qdot))\n           (* 1/2 m (square Omega) (square q))\n           (* m Omega (- (* x ydot) (* xdot y)))\n           (/ (* GM0 m) r0) (/ (* GM1 m) r1))))))" :translated "(defn LR3B [m a GM0 GM1]\n  (fn [local]\n        (let [q (coordinate local)\n                qdot (velocities local)\n                Omega (sqrt (/ (+ GM0 GM1) (expt a 3)))\n                a0 (* (/ GM1 (+ GM0 GM1)) a)\n                a1 (* (/ GM0 (+ GM0 GM1)) a)]\n            (let [x (ref q 0)\n                     y (ref q 1)\n                     xdot (ref qdot 0)\n                     ydot (ref qdot 1)]\n                 (let [r0 (sqrt (+ (square (+ x a0)) (square y)))\n                          r1 (sqrt (+ (square (- x a1)) (square y)))]\n                      (+\n                           (* 1/2 m (square qdot))\n                           (* 1/2 m (square Omega) (square q))\n                           (* m Omega (- (* x ydot) (* xdot y)))\n                           (/ (* GM0 m) r0) (/ (* GM1 m) r1)))))))"}
  {:chapter "1" :section "1.8.4" :page 88 :idx 70 :code "(define ((LR3B1 m a0 a1 Omega GM0 GM1) local)\n  (let ((q (coordinates local))\n        (qdot (velocities local)))\n    (let ((x (ref q 0))     (y (ref q 1))\n                            (xdot (ref qdot 0)) (ydot (ref qdot 1)))\n      (let ((r0 (sqrt (+ (square (+ x a0)) (square y))))\n            (r1 (sqrt (+ (square (- x a1)) (square y)))))\n        (+ (* 1/2 m (square qdot))\n           (* 1/2 m (square Omega) (square q))\n           (* m Omega (- (* x ydot) (* xdot y)))\n           (/ (* GM0 m) r0) (/ (* GM1 m) r1))))))" :translated "(defn LR3B1 [m a0 a1 Omega GM0 GM1]\n  (fn [local]\n        (let [q (coordinate local) qdot (velocities local)]\n            (let [x (ref q 0)\n                     y (ref q 1)\n                     xdot (ref qdot 0)\n                     ydot (ref qdot 1)]\n                 (let [r0 (sqrt (+ (square (+ x a0)) (square y)))\n                          r1 (sqrt (+ (square (- x a1)) (square y)))]\n                      (+\n                           (* 1/2 m (square qdot))\n                           (* 1/2 m (square Omega) (square q))\n                           (* m Omega (- (* x ydot) (* xdot y)))\n                           (/ (* GM0 m) r0) (/ (* GM1 m) r1)))))))"}
