  {:chapter "5" :section "5.2" :page 345 :idx 165 :code "(define ((H-harmonic m k) s)\n  (+ (/ (square (momentum s)) (* 2 m))\n     (* 1/2 k (square (coordinate s)))))\n\n((canonical?\n   (polar-canonical 'alpha)\n   (H-harmonic 'm 'k)\n   (compose (H-harmonic 'm 'k)\n            (polar-canonical 'alpha)))\n (up 't 'theta 'I))" :translated "(defn H-harmonic [m k]\n  (fn [s]\n        (+\n            (/ (square (momentum s)) (* 2 m))\n            (* 1/2 k (square (coordinate s))))))\n\n\n((canonical?\n   (polar-canonical 'alpha) (H-harmonic 'm 'k)\n   (compose (H-harmonic 'm 'k) (polar-canonical 'alpha)))\n  (up\n                                                                                                                        't\n                                                                                                                        'theta\n                                                                                                                        'I))" :expected "(up 0 0 0)"}
  {:chapter "5" :section "5.2.1" :page 347 :idx 166 :code "(define (T-func s)\n  (up 1\n      (zero-like (coordinates s))\n      (zero-like (momenta s))))\n\n(define ((D-phase-space H) s)\n  (up 0 (((partial 2) H) s) (- (((partial 1) H) s))))" :translated "(defn T-func [s]\n  (up 1 (zero-like (coordinate s)) (zero-like (momentum s))))\n\n\n(defn D-phase-space [H]\n  (fn [s] (up 0 (((partial 2) H) s) (- (((partial 1) H) s)))))"}
  {:chapter "5" :section "5.2.1" :page 348 :idx 167 :code "(define (canonical-H? C H)\n  (- (compose (D-phase-space H) C)\n     (* (D C)\n        (D-phase-space (compose H C)))))\n\n(define (canonical-K? C K)\n  (- (compose T-func C)\n     (* (D C)\n        (+ T-func (D-phase-space K)))))" :translated "(defn canonical-H? [C H]\n  (-\n        (compose (D-phase-space H) C)\n        (* (D C) (D-phase-space (compose H C)))))\n\n\n(defn canonical-K? [C K]\n  (- (compose T-func C) (* (D C) (+ T-func (D-phase-space K)))))"}
  {:chapter "5" :section "5.2.1" :page 348 :idx 168 :code "(define ((rotating Omega) state)\n  (let ((t (time state)) (qp (coordinate state)))\n    (let ((xp (ref qp 0)) (yp (ref qp 1)) (zp (ref qp 2)))\n      (up (- (* (cos (* Omega t)) xp)\n             (* (sin (* Omega t)) yp))\n          (+ (* (sin (* Omega t)) xp)\n             (* (cos (* Omega t)) yp))\n          zp))))" :translated "(defn rotating [Omega]\n  (fn [state]\n        (let [t (state->t state) qp (coordinate state)]\n            (let [xp (ref qp 0) yp (ref qp 1) zp (ref qp 2)]\n                 (up\n                      (-\n                          (* (cos (* Omega t)) xp)\n                          (* (sin (* Omega t)) yp))\n                      (+\n                          (* (sin (* Omega t)) xp)\n                          (* (cos (* Omega t)) yp))\n                      zp)))))"}
