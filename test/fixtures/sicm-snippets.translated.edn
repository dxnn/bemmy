  {:chapter "4" :section "4.6.1" :page 327 :idx 153 :code "(define (which-way? rotation-number x0 y0 the-map)\n  (let ((pv (principal-value ( x0 pi))))\n    (let lp ((z x0) (zmin (- x0 :2pi)) (zmax (+ x0 :2pi))\n                    (x x0) (xmin (- x0 :2pi)) (xmax (+ x0 :2pi))\n                    (y y0))\n      (let ((nz (pv (+ z (* :2pi rotation-number)))))\n        (the-map x y\n                 (lambda (nx ny)\n                   (let ((nx (pv nx)))\n                     (cond ((< x0 z zmax)\n                            (if (< x0 x xmax)\n                              (lp nz zmin z nx xmin x ny)\n                              (if (> x xmax) 1 -1)))\n                           ((< zmin z x0)\n                            (if (< xmin x x0)\n                              (lp nz z zmax nx x xmax ny)\n                              (if (< x xmin) -1 1)))\n                           (else\n                             (lp nz zmin zmax nx xmin xmax ny)))))\n                 (lambda ()\n                   (error \"Map failed\" x y)))))))" :translated "(defn which-way? [rotation-number x0 y0 the-map]\n  (let [pv (principal-value (x0 pi))]\n        (loop [z x0\n                  zmin (- x0 (* 2 Math/PI))\n                  zmax (+ x0 (* 2 Math/PI))\n                  x x0\n                  xmin (- x0 (* 2 Math/PI))\n                  xmax (+ x0 (* 2 Math/PI))\n                  y y0]\n             (let [nz (pv (+ z (* (* 2 Math/PI) rotation-number)))]\n                   (the-map\n                        x y\n                        (fn [nx ny]\n                                 (let [nx (pv nx)]\n                                     (cond\n                                          (< x0 z zmax)\n                                          (if (< x0 x xmax)\n                                                (lp\n                                                    nz zmin z nx xmin x\n                                                    ny)\n                                                (if (> x xmax) 1 -1))\n                                          (< zmin z x0)\n                                          (if (< xmin x x0)\n                                                (lp\n                                                    nz z zmax nx x xmax\n                                                    ny)\n                                                (if (< x xmin) -1 1))\n                                          :else\n                                          (lp\n                                                nz zmin zmax nx xmin\n                                                xmax ny))))\n                        (fn [] (throw (ex-info \"Map failed\" {}))))))))"}
  {:chapter "5" :section "5.1" :page 339 :idx 154 :code "(define ((F->CH F) state)\n  (up (time state)\n      (F state)\n      (solve-linear-right\n        (momentum state)\n        (((partial 1) F) state))))" :translated "(defn F->CH [F]\n  (fn [state]\n        (up\n            (state->t state) (F state)\n            (solve-linear-right\n                (momentum state) (((partial 1) F) state)))))"}
