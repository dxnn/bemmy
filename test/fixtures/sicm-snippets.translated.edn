  {:chapter "1" :section "1.12" :page 118 :idx 81 :code "(define (make-path t0 q0 t1 q1 qs)\n  (let ((n (length qs)))\n    (let ((ts (linear-interpolants t0 t1 n)))\n      (Lagrange-interpolation-function\n        (append (list q0) qs (list q1))\n        (append (list t0) ts (list t1))))))" :translated "(defn make-path [t0 q0 t1 q1 qs]\n  (let [n (count qs)]\n        (let [ts (linear-interpolants t0 t1 n)]\n             (Lagrange-interpolation-function\n                  (concat\n                                                   (list q0) qs\n                                                   (list q1))\n                  (concat\n                                                   (list t0) ts\n                                                   (list t1))))))"}
