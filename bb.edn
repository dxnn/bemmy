{:paths ["src"]

 :deps
 {io.github.babashka/scittle.build
  {:git/url "https://github.com/babashka/scittle"
   :git/sha "465cc3251af411a2c34503e5ed0558d1ba218ea8"
   :deps/root "build"}
  io.github.babashka/http-server
  {:git/sha "b38c1f16ad2c618adae2c3b102a5520c261a7dd3"}}

 :tasks
 {:requires ([scittle.build :as build])

  test    {:doc  "Run unit tests (sicm2emmy translator + auto-graph wrap)"
           :task (do (shell "node --test test/sicm2emmy.test.js test/sicm2emmy.corpus.test.js")
                     (shell "bb test/auto_graph_test.clj"))}

  gen-pages {:doc  "Regenerate SICM section pages in public/app.cljs from the corpus."
             :task (do (shell "node test/translate-corpus.js")
                       (shell "bb bin/build-sicm-pages.bb"))}

  test-eq {:doc  "Run SICM↔Emmy equivalence + section-page eval tests."
           :task (do
                   (shell "node test/translate-corpus.js")
                   (shell "bb bin/build-sicm-pages.bb")
                   ;; Run both Clojure suites; collect exit codes so a
                   ;; pre-existing failure in one doesn't mask the other.
                   (let [eq-exit    (:exit (shell {:continue true} "clojure -M:test"))
                         pages-exit (:exit (shell {:continue true} "clojure -M:test:pages"))]
                     (when (or (pos? eq-exit) (pos? pages-exit))
                       (System/exit (max eq-exit pages-exit)))))}

  watch   {:doc  "Watch build (recompile on save)"
           :task (build/build {:action "watch"})}

  serve   {:doc  "Serve public/ as static files"
           :requires ([babashka.http-server :as http])
           :task (do (http/serve {:port 1341 :dir "public"})
                     (println "Serving at http://localhost:1341"))}

  -dev    {:depends [watch serve]}

  dev     {:doc  "Watch + serve in parallel"
           :task (do (run '-dev {:parallel true})
                     (deref (promise)))}

  release {:doc  "Advanced-compiled release build"
           :task (build/build {})}}}
